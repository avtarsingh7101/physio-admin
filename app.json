{
  "expo": {
    "name": "PhysioHub Admin",
    "slug": "physio-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.tricityphysiohub.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1a365d"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1a365d"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://tricityphysiohub.in",
      "eas": {
        "projectId": "8e57bbf8-0538-43b0-864b-4fe93bab8d46"
      }
    }
  }
}
